[api]
filters = {"category":{"id":"2"},"enums":{"ad_type":["offer"]},"location":{"locations":[{"locationType":"city","city":"14e Arrondissement","zipcode":"75014","label":"14e Arrondissement (75014)","region_id":"12","department_id":"75","area":{"lat":48.83292,"lng":2.3248,"default_radius":2379,"radius":5000}}]}}
limit = 35
limit_alu = 3
sort_by = "time"
sort_order = "desc"
offset = 0
disable_total = true
extend = true
listing_source = "pagination"

[headers]
accept = */*
accept-encoding = gzip, deflate, br, zstd
accept-language = fr-FR,fr;q=0.9,en-US;q=0.8,en;q=0.7
content-type = application/json
user-agent = Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36
api_key = ba0c2dad52b3ec
origin = https://www.leboncoin.fr
referer = https://www.leboncoin.fr/c/voitures?locations=14e+Arrondissement_75014__48.83292_2.3248_2379_5000
sec-ch-ua = "Google Chrome";v="141", "Not?A_Brand";v="8", "Chromium";v="141"
sec-ch-ua-mobile = ?0
sec-ch-ua-platform = "Windows"
sec-fetch-dest = empty
sec-fetch-mode = cors
sec-fetch-site = same-site
priority = u=1, i

[cookies]
# Either provide key=value pairs, or a single raw cookie header under 'cookie'
# cookie = __Secure-Install=...; cnfdVisitorId=...; didomi_token=...

[client]
# curl_cffi impersonation preset, e.g., chrome141, chrome131_android, safari17_ios, etc.
impersonate = chrome141
timeout = 30

[mongodb]
# Either provide a full connection URI or host/port/username/password/authSource
# uri = mongodb+srv://user:pass@cluster0.mongodb.net/?retryWrites=true&w=majority
host = localhost
port = 27017
username =
password =
authSource = admin
database = leboncoin
collection = ads
runs_collection = runs
