model Evaluation {
  id                String   @id @default(uuid())
  userId            String?  @map("user_id")
  subject           String?  @db.Text
  locationCountryId String?  @map("location_country_id") @db.VarChar(50)
  locationCity      String?  @map("location_city") @db.VarChar(255)
  carBrand          String   @map("car_brand") @db.VarChar(255)
  carModel          String   @map("car_model") @db.VarChar(255)
  regdate           String?  @db.VarChar(50)
  mileage           Int
  fuelLabel         String?  @map("fuel_label") @db.VarChar(255)
  gearboxLabel      String?  @map("gearbox_label") @db.VarChar(255)
  doors             Int?
  seats             Int?
  vehiculeColor     String?  @map("vehicule_color") @db.VarChar(255)
  horsepowerDin     Int?     @map("horsepower_din")
  predictedPrice    Decimal  @map("predicted_price") @db.Decimal(10, 2)
  priceRangeMin     Decimal  @map("price_range_min") @db.Decimal(10, 2)
  priceRangeMax     Decimal  @map("price_range_max") @db.Decimal(10, 2)
  confidence        Float
  similarCarsCount  Int      @map("similar_cars_count")
  isPaid            Boolean  @default(false) @map("is_paid")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([carBrand, carModel])
  @@map("car_evaluations")
}
